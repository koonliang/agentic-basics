{
  "name": "agentic-ai-lab02",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "client": "node --env-file-if-exists=../.env --import tsx src/client-index.ts",
    "server": "node --env-file-if-exists=../.env --import tsx src/server-index.ts",
