{
  "name": "agentic-ai-lab08",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "submit": "node --env-file-if-exists=../.env --import tsx src/index.ts submit",
    "status": "node --env-file-if-exists=../.env --import tsx src/index.ts status",
    "score": "node --env-file-if-exists=../.env --import tsx src/index.ts score",
    "demo": "npm run submit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}
